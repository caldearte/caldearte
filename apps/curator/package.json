{
  "name": "@caldearte/curator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test src/**/*.test.ts",
    "discover-events": "node --import tsx src/index.ts",
    "discover-headless-sources": "node --import tsx src/headless-index.ts",
    "discover-instagram-sources": "node --import tsx src/instagram-index.ts",
    "discover-google-alerts-source": "node --import tsx src/google-alerts-index.ts",
    "send-newsletter": "node --import tsx src/newsletter-index.ts",
    "publish-social": "node --import tsx src/social-publish-index.ts",
    "record-apify-usage": "node --import tsx src/apify-usage-snapshot-index.ts",
    "record-instagram-insights": "node --import tsx src/instagram-insights-index.ts",
    "send-daily-digest": "node --import tsx src/daily-digest-index.ts",
    "security-audit": "node --import tsx src/security-audit-index.ts",
    "poc-tavily": "node --env-file=../../.env --import tsx scripts/poc-tavily-discover.ts",
    "query-variant-test": "node --env-file=../../.env --import tsx scripts/query-variant-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@caldearte/curation-policy": "workspace:*",
    "@caldearte/shared-types": "workspace:*",
    "@supabase/supabase-js": "^2.110.2",
    "apify-client": "^2.25.0",
    "playwright": "^1.61.1",
    "resend": "^6.17.2"
  },
  "devDependencies": {
    "tsx": "^4.23.0"
  }
}
